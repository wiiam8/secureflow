# Copy to .env and edit. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
BASE_URL=http://localhost:8000
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@secureflow.local
# Leave empty to get a random password printed once in the API logs.
ADMIN_PASSWORD=
